{
  "name": "nitesh-portfolio-v3",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev --host 0.0.0.0 --port 4321",
    "check": "astro check",
    "build": "astro build",
    "deploy": "npm run build && surge ./dist publish",
    "preview": "astro preview --host 0.0.0.0 --port 4321",
    "format": "prettier --write \"src/**/*.{astro,ts,md,mdx,css}\" \"scripts/*.mjs\" \"*.json\" \"*.mjs\" \".github/**/*.yml\" \"templates/*.md\" \"GLOSSARY.md\"",
    "format:check": "prettier --check \"src/**/*.{astro,ts,md,mdx,css}\" \"scripts/*.mjs\" \"*.json\" \"*.mjs\" \".github/**/*.yml\" \"templates/*.md\" \"GLOSSARY.md\""
  },
  "dependencies": {
    "@astrojs/mdx": "8.0.3",
    "@fontsource/fira-mono": "^5.3.0",
    "astro": "7.3.7",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@types/three": "^0.186.0",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.1",
    "sharp": "0.35.5",
    "surge": "0.44.7",
    "typescript": "6.0.3"
  }
}
