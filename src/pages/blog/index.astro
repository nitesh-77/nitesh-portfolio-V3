---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPublishedBlog } from '../../lib/content';
import { href } from '../../lib/href';

const posts = await getPublishedBlog();
---
<BaseLayout title="Blogs | Nitesh" description="Writing by Nitesh about language models, systems, and AI applications.">
  <main id="main" class="detail-page">
    <a class="back-link" href={href('/')}>Back to home</a>
    <h1>Blogs</h1>
    {posts.length === 0 ? <p>Posts coming soon.</p> : (
      <ul class="blog-list">
        {posts.map((post) => (
          <li>
            <h2><a href={href(`/blog/${post.id}/`)}>{post.data.title}</a></h2>
            <time datetime={post.data.published.toISOString()}>{post.data.published.toLocaleDateString('en-GB', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' })}</time>
            <p>{post.data.description}</p>
          </li>
        ))}
      </ul>
    )}
  </main>
</BaseLayout>
