---
import { render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPublishedBlog } from '../../lib/content';
import { href } from '../../lib/href';

export async function getStaticPaths() {
  return (await getPublishedBlog()).map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<'blog'>;
}
const { entry } = Astro.props;
const { Content } = await render(entry);
---

<BaseLayout title={`${entry.data.title} | Nitesh`} description={entry.data.description}>
  <main id="main" class="blog-article">
    <a class="back-link" href={href('/blog/')}>
      Back to blogs
    </a>
    <h1>{entry.data.title}</h1>
    <time datetime={entry.data.published.toISOString()}>
      {entry.data.published.toLocaleDateString('en-GB', {
        year: 'numeric',
        month: 'long',
        day: 'numeric',
        timeZone: 'UTC',
      })}
    </time>
    <div class="prose">
      <Content />
    </div>
  </main>
</BaseLayout>

<style>
  .blog-article {
    max-width: 720px;
    margin: 0 auto;
    padding: 48px 28px 80px;
    overflow-wrap: anywhere;
  }
  .back-link {
    font-family: 'Fira Mono', monospace;
    font-size: 14px;
    line-height: 1.6;
  }
  h1 {
    margin: 36px 0 20px;
    font-family: var(--sans);
    font-size: 48px;
    font-weight: 700;
    line-height: 1.12;
    text-wrap: balance;
  }
  time {
    color: #a2a69f;
    font-family: 'Fira Mono', monospace;
    font-size: 13px;
    line-height: 1.6;
  }
  .prose {
    margin-top: 44px;
    font-family: Georgia, 'Times New Roman', serif;
    font-size: 20px;
    line-height: 1.8;
  }
  .prose :global(p) {
    margin: 0 0 24px;
  }
  .prose :global(h2) {
    margin: 44px 0 20px;
    font-family: var(--sans);
    font-size: 28px;
    font-weight: 700;
    line-height: 1.3;
  }
  .prose :global(h2:first-child) {
    margin-top: 0;
  }
  .prose :global(ul) {
    margin: 0 0 24px;
    padding-left: 26px;
  }
  .prose :global(li) {
    padding-left: 4px;
  }
  .prose :global(li + li) {
    margin-top: 6px;
  }
  .prose :global(strong) {
    font-weight: 700;
  }
  .prose :global(figure) {
    margin: 32px 0;
  }
  .prose :global(figure img) {
    display: block;
    width: 100%;
    height: auto;
  }
  .prose :global(figcaption) {
    margin-top: 12px;
    color: #a2a69f;
    font-family: 'Fira Mono', monospace;
    font-size: 14px;
    line-height: 1.6;
  }
  .prose :global(sup) {
    font-size: 0.7em;
  }
  .prose :global(.footnotes) {
    margin-top: 40px;
    padding-top: 24px;
    border-top: 1px solid #353c35;
    font-family: Georgia, 'Times New Roman', serif;
    font-size: 16px;
    line-height: 1.7;
  }
  .prose :global(.footnotes p) {
    margin-bottom: 16px;
  }
  .prose :global([id^='fn']) {
    scroll-margin-top: 24px;
  }

  @media (max-width: 700px) {
    .blog-article {
      padding: 28px 22px 48px;
    }
    h1 {
      margin-top: 28px;
      font-size: 34px;
    }
    .prose {
      margin-top: 36px;
      font-size: 19px;
    }
    .prose :global(h2) {
      font-size: 25px;
    }
  }
</style>
