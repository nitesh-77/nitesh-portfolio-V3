---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getWork, workSection, type Work } from '../../lib/content';
import { href } from '../../lib/href';

export async function getStaticPaths() {
  return (await getWork()).map((entry) => ({
    params: { section: workSection(entry.data.kind), slug: entry.id },
    props: { entry },
  }));
}

interface Props {
  entry: Work;
}
const { entry } = Astro.props;
const { Content } = await render(entry);
---

<BaseLayout title={`${entry.data.title} | Nitesh`} description={entry.data.description}>
  {entry.data.presentation === 'visual' ? (
    <main id="main">
      <Content />
    </main>
  ) : (
    <main id="main" class="detail-page">
      <a class="back-link" href={href('/')}>
        Back to home
      </a>
      <h1>{entry.data.title}</h1>
      <p class="detail-description">{entry.data.description}</p>
      {entry.data.links && entry.data.links.length > 0 && (
        <ul class="detail-links">
          {entry.data.links.map((link) => (
            <li>
              <a href={link.href}>{link.label}</a>
            </li>
          ))}
        </ul>
      )}
      <div class="prose">
        {entry.body?.trim() ? <Content /> : <p>Full write-up coming soon.</p>}
      </div>
    </main>
  )}
</BaseLayout>
