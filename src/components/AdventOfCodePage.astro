---
import { href } from '../lib/href';
---

<article class="advent-page">
  <nav aria-label="Project navigation">
    <a href={href('/')}>
      <span aria-hidden="true">← </span>Back home
    </a>
    <a
      class="project-source-link"
      href="https://github.com/nitesh-77/advent-of-code-2025"
      aria-label="View Advent of Code 2025 solutions on GitHub"
      title="Solutions on GitHub"
    >
      <img src={href('/media/brands/github.svg')} width="36" height="36" alt="" />
      <span>GitHub</span>
    </a>
  </nav>

  <header>
    <h1>Advent of Code 2025</h1>
    <p class="intro">
      Advent of Code is a yearly set of programming puzzles released in December. These are my
      solutions to the 2025 puzzles.
    </p>
  </header>

  <figure>
    <img
      src={href('/media/advent-of-code/2025-artwork.webp')}
      width="885"
      height="826"
      alt="Advent of Code 2025 ASCII artwork showing numbered puzzle rows and stars."
      decoding="async"
    />
  </figure>
</article>

<style>
  .advent-page {
    max-width: 1040px;
    margin: 0 auto;
    padding: 48px 28px 64px;
    font:
      17px/1.6 'Fira Mono',
      monospace;
  }
  nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 14px;
  }
  nav a {
    padding: 8px 0;
    text-decoration: none;
  }
  nav a:hover {
    text-decoration: underline;
  }
  header {
    margin: 36px 0 40px;
  }
  h1 {
    margin: 0 0 20px;
    font-family: var(--sans);
    font-size: 52.8px;
    line-height: 1.1;
    letter-spacing: -0.035em;
  }
  .intro {
    max-width: 960px;
    margin: 0;
    color: var(--muted);
    font:
      italic 26px/1.4 Georgia,
      serif;
    text-align: left;
    text-wrap: pretty;
  }
  figure {
    max-width: 560px;
    margin: 0 auto;
  }
  figure img {
    display: block;
    width: 100%;
    height: auto;
  }
  @media (max-width: 760px) {
    .advent-page {
      padding: 28px 22px 48px;
    }
    nav {
      font-size: 12px;
    }
    header {
      margin: 28px 0 32px;
    }
    h1 {
      margin-bottom: 16px;
      font-size: clamp(31px, 7vw, 45px);
    }
    .intro {
      font-size: 24px;
      line-height: 1.4;
    }
  }
</style>
