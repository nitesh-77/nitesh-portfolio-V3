---
import { href } from '../lib/href';
import data from '../data/distillation-activations.json';
---

<div class="activation-viewer">
  <div class="viewer-controls" hidden>
    <label>
      Saved example{' '}
      <select data-example>
        {data.samples.map((sample, i) => (
          <option value={i}>{sample.title}</option>
        ))}
      </select>
    </label>
    <span>Original checkpoint · test split</span>
  </div>
  <div class="heatmaps" hidden>
    {['Qwen attention', 'Hyena', 'Qwen − Hyena'].map((name) => (
      <div class="heatmap">
        <h3>{name}</h3>
        <canvas
          width="256"
          height="256"
          aria-label={`${name} activation heatmap. Inspect exact values using the token and channel controls below.`}
          role="img"
        ></canvas>
        <span class="scale"></span>
      </div>
    ))}
  </div>
  <div class="cell-controls" hidden>
    <label>
      Token <input data-token type="range" min="0" max="63" value="0" />
    </label>
    <label>
      Channel <input data-channel type="range" min="0" max="63" value="0" />
    </label>
    <output aria-live="polite" data-values></output>
    <small>
      First 64 tokens; 64 evenly spaced channels out of 3,584. Saved float16 values, rounded to six
      decimals.
    </small>
  </div>
  <a
    class="static-comparison figure-link"
    href={href('/media/llm-layer-distillation/mi300x-bf16-512/comparison_median.png')}
  >
    <img
      src={href('/media/llm-layer-distillation/mi300x-bf16-512/comparison_median.png')}
      width="2400"
      height="800"
      alt="Saved test example: Qwen attention output, original Hyena output, and their difference."
      loading="lazy"
    />
  </a>
  <small>
    Left to right: token position. Top to bottom: channel. Blue is negative; red is positive. Qwen
    and Hyena share a scale; the difference has its own scale.
  </small>
</div>

<script>
  import data from '../data/distillation-activations.json';

  document.querySelectorAll<HTMLElement>('.activation-viewer').forEach((root) => {
    const selector = root.querySelector<HTMLSelectElement>('[data-example]');
    const token = root.querySelector<HTMLInputElement>('[data-token]');
    const channel = root.querySelector<HTMLInputElement>('[data-channel]');
    const output = root.querySelector<HTMLOutputElement>('[data-values]');
    const canvases = Array.from(root.querySelectorAll<HTMLCanvasElement>('canvas'));
    const contexts = canvases.map((canvas) => canvas.getContext('2d'));
    if (!selector || !token || !channel || !output || contexts.some((context) => !context)) return;

    function draw() {
      if (!selector || !token || !channel || !output) return;
      const sample = data.samples[Number(selector.value)];
      if (!sample) return;
      const col = Number(token.value);
      const row = Number(channel.value);
      const index = row * sample.tokenCount + col;
      const qwen = sample.qwen[index];
      const hyena = sample.hyena[index];
      output.textContent = `Token ${col} · channel ${sample.channels[row]}: Qwen ${qwen.toFixed(5)} / Hyena ${hyena.toFixed(5)} / difference ${(qwen - hyena).toFixed(5)}`;
      const difference = sample.qwen.map((value, i) => value - sample.hyena[i]);
      const sharedScale = Math.max(
        ...sample.qwen.map(Math.abs),
        ...sample.hyena.map(Math.abs),
        0.000001,
      );
      const errorScale = Math.max(...difference.map(Math.abs), 0.000001);
      const matrices = [sample.qwen, sample.hyena, difference];
      matrices.forEach((values, panel) => {
        const ctx = contexts[panel];
        const canvas = canvases[panel];
        if (!ctx || !canvas) return;
        const scale = panel === 2 ? errorScale : sharedScale;
        const cellWidth = canvas.width / sample.tokenCount;
        const cellHeight = canvas.height / sample.channels.length;
        values.forEach((value, i) => {
          const strength = Math.min(1, Math.abs(value) / scale);
          const end = value < 0 ? [54, 115, 169] : [195, 65, 58];
          const rgb = end.map((component) => Math.round(239 + (component - 239) * strength));
          ctx.fillStyle = `rgb(${rgb.join(',')})`;
          ctx.fillRect(
            (i % sample.tokenCount) * cellWidth,
            Math.floor(i / sample.tokenCount) * cellHeight,
            cellWidth,
            cellHeight,
          );
        });
        ctx.strokeStyle = '#111';
        ctx.lineWidth = 1.5;
        ctx.strokeRect(col * cellWidth, row * cellHeight, cellWidth, cellHeight);
        const label = canvas.parentElement?.querySelector('.scale');
        if (label) label.textContent = `−${scale.toFixed(3)}  /  0  /  +${scale.toFixed(3)}`;
      });
    }
    selector.addEventListener('change', draw);
    token.addEventListener('input', draw);
    channel.addEventListener('input', draw);
    canvases.forEach((canvas) =>
      canvas.addEventListener('pointerdown', (event) => {
        const rect = canvas.getBoundingClientRect();
        token.value = String(
          Math.min(63, Math.max(0, Math.floor(((event.clientX - rect.left) / rect.width) * 64))),
        );
        channel.value = String(
          Math.min(63, Math.max(0, Math.floor(((event.clientY - rect.top) / rect.height) * 64))),
        );
        draw();
      }),
    );
    draw();
    root
      .querySelectorAll<HTMLElement>('.viewer-controls,.heatmaps,.cell-controls')
      .forEach((node) => {
        node.hidden = false;
      });
    const fallback = root.querySelector<HTMLElement>('.static-comparison');
    if (fallback) fallback.hidden = true;
  });
</script>

<style>
  .activation-viewer {
    max-width: 1000px;
    margin: 28px auto;
  }
  .viewer-controls {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    margin-bottom: 20px;
    font-size: 17px;
  }
  .viewer-controls label {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    align-items: center;
  }
  select {
    max-width: 100%;
    padding: 8px;
    background: var(--background);
    color: var(--text);
    border: 1px solid #68706c;
    font: inherit;
  }
  .viewer-controls span,
  small,
  .scale {
    color: var(--muted);
    overflow-wrap: anywhere;
  }
  .viewer-controls span {
    font-size: 17px;
  }
  .scale {
    font-size: 15px;
  }
  .heatmaps {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
  }
  h3 {
    margin: 0 0 12px;
    font-family: 'Fira Mono', monospace;
    font-size: 17px;
    font-weight: 400;
    overflow-wrap: anywhere;
  }
  canvas {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1;
    image-rendering: pixelated;
    cursor: crosshair;
  }
  .scale {
    display: block;
    margin-top: 8px;
  }
  .cell-controls {
    display: flex;
    flex-wrap: wrap;
    gap: 16px 24px;
    margin: 22px 0 14px;
    font-size: 17px;
  }
  .cell-controls label {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  input {
    accent-color: #e4bb7a;
    max-width: 130px;
  }
  output {
    display: block;
    flex-basis: 100%;
    min-height: 2.5em;
    font-size: var(--story-body-size, 20px);
    overflow-wrap: anywhere;
  }
  small {
    display: block;
    font-size: var(--story-body-size, 20px);
    line-height: 1.65;
  }
  @media (max-width: 700px) {
    .heatmaps {
      gap: 10px;
    }
    .viewer-controls,
    .cell-controls {
      font-size: 15px;
    }
    h3 {
      font-size: 15px;
      min-height: 3.3em;
    }
    .viewer-controls span {
      font-size: 15px;
    }
    .scale {
      font-size: 12px;
    }
  }
</style>
